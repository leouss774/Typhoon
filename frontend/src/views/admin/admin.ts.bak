/**
 * Admin view module — lightweight lifecycle for admin overview stats.
 */
import { fetchDashboardStats, fetchClientsFromApi } from '../../api/data-service.js';

let initialized = false;

export function initAdminOverview(): void {
  if (initialized) return;
  initialized = true;
  loadAdminStats();
}

export function destroyAdminOverview(): void {
  initialized = false;
}

async function loadAdminStats(): Promise<void> {
  try {
    const [stats, clients] = await Promise.all([
      fetchDashboardStats().catch(() => null),
      fetchClientsFromApi().catch(() => []),
    ]);

    if (stats) {
      const setText = (id: string, val: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      setText('adminStatUsers', String(stats.totalClients + 4)); // approximate total users
      setText('adminStatAssureurs', '3');
      setText('adminStatAssures', String(stats.activeClients));
      setText('adminStatClients', String(stats.totalClients));
      setText('adminStatProps', String(stats.totalProperties));
      setText('adminStatAssessments', String(stats.totalAssessments));
    }

    // Populate admin clients table
    const tbody = document.getElementById('adminClientsBody');
    if (tbody && clients.length > 0) {
      tbody.innerHTML = clients.map(c => `
        <tr>
          <td style="padding:10px 14px;border-bottom:1px solid var(--border-color);font-size:13px;">
            <strong>${escapeHtml(c.firstName)} ${escapeHtml(c.lastName)}</strong>
          </td>
          <td style="padding:10px 14px;border-bottom:1px solid var(--border-color);font-size:13px;color:var(--text-secondary);">
            ${escapeHtml(c.email || '—')}
          </td>
          <td style="padding:10px 14px;border-bottom:1px solid var(--border-color);font-size:13px;">
            <span style="padding:2px 8px;border-radius:10px;font-size:11px;background:rgba(99,102,241,0.1);color:#6366f1;">Assureur</span>
          </td>
          <td style="padding:10px 14px;border-bottom:1px solid var(--border-color);font-size:13px;">
            <span style="padding:2px 8px;border-radius:10px;font-size:11px;background:${c.status === 'active' ? 'rgba(16,185,129,0.1);color:#10b981' : 'rgba(245,158,11,0.1);color:#f59e0b'};">
              ${c.status === 'active' ? 'Actif' : 'En attente'}
            </span>
          </td>
          <td style="padding:10px 14px;border-bottom:1px solid var(--border-color);">
            <button style="padding:4px 10px;border:1px solid var(--border-color);border-radius:6px;background:transparent;cursor:pointer;font-size:11px;font-family:var(--font-primary);">Voir</button>
          </td>
        </tr>
      `).join('');
    }
  } catch (err) {
    console.warn('[Admin] Failed to load stats:', err);
  }
}

function escapeHtml(str: string): string {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}
