# --- Server ---
PORT=8000
ENVIRONMENT=development

# --- Database ---
# SQLite (dev):
DATABASE_URL=sqlite:///./data/previa.db
# Supabase PostgreSQL (prod - replace <PASSWORD>):
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres

# --- Auth (Custom JWT fallback) ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_HOURS=24
COOKIE_SECURE=false

# --- Supabase (PostgreSQL + Auth) ---
# Get keys from: https://supabase.com/dashboard/project/<PROJECT>/settings/api
SUPABASE_URL=https://<PROJECT>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>

# --- External APIs ---
GEORISQUES_V2_TOKEN=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Frontend (Vite) ---
# VITE_ vars are exposed to the browser by Vite
VITE_SUPABASE_URL=<your-supabase-url>
VITE_SUPABASE_ANON_KEY=<your-anon-key>
